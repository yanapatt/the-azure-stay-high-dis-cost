      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Benton Sans Book'>Net ADR &amp; Net RevPAR vs. Booking Channels</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
