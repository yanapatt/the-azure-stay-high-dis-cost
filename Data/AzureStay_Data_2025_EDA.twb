    <worksheet name='Hypothesis4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Booking Share (%) by Guest Type and Channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_date+ (AzureStay_Data_2025)' name='federated.1lsanfy1tem9aa1b6f4g41qxk9fb' />
          </datasources>
          <datasource-dependencies datasource='federated.1lsanfy1tem9aa1b6f4g41qxk9fb'>
            <column caption='Booking Share %' datatype='real' name='[Calculation_0162241548107780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0206221859119124] / SUM({ EXCLUDE [channel_type] : [Calculation_0206221859119124] })' />
            </column>
            <column caption='Filter Status' datatype='boolean' name='[Calculation_0206221829849092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[status] = &apos;Checked-Out&apos; OR [status] = &apos;Confirmed&apos;' />
            </column>
            <column caption='Total Bookings' datatype='integer' name='[Calculation_0206221859119124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([booking_id])' />
            </column>
            <column caption='Booking Id' datatype='string' name='[booking_id]' role='dimension' type='nominal' />
            <column caption='Channel Type' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Guest Type' datatype='string' name='[guest_type]' role='dimension' type='nominal' />
