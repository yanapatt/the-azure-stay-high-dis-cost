            <column-instance column='[Calculation_0206221878022167]' derivation='User' name='[usr:Calculation_0206221878022167:ok]' pivot='key' type='ordinal' />
            <column-instance column='[TrueCOA% (copy)_0206221883121688]' derivation='User' name='[usr:TrueCOA% (copy)_0206221883121688:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[none:Calculation_0206221829849092:nk]'>
            <groupfilter function='member' level='[none:Calculation_0206221829849092:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[none:channel_name:nk]'>
