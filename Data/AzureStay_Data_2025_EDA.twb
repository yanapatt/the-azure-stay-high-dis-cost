            <column caption='Net Opportunity Loss' datatype='real' name='[Calculation_0206221908955179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221898047519]) - [Calculation_0206221908709418]' />
