    <worksheet name='Hypothesis5.2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Opportunity Cost Analysis: Room Volume vs. Profitability by Channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_date+ (AzureStay_Data_2025)' name='federated.1lsanfy1tem9aa1b6f4g41qxk9fb' />
          </datasources>
          <datasource-dependencies datasource='federated.1lsanfy1tem9aa1b6f4g41qxk9fb'>
            <column caption='Length Of Stay' datatype='integer' name='[Calculation_0206221829160961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [check_in_date], [check_out_date])' />
            </column>
            <column caption='Daily Net Room Revenue' datatype='real' name='[Calculation_0206221829292034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[net_room_revenue] / [Calculation_0206221829160961]' />
            </column>
            <column caption='NetADR' datatype='real' name='[Calculation_0206221829443587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221829292034]) / SUM([number_of_rooms])' />
            </column>
            <column caption='Filter Status' datatype='boolean' name='[Calculation_0206221829849092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[status] = &apos;Checked-Out&apos; OR [status] = &apos;Confirmed&apos;' />
            </column>
            <column caption='LOD Daily Sold' datatype='integer' name='[Calculation_0947567766609921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date], [booking_id] : SUM([number_of_rooms]) }' />
            </column>
            <column caption='LOD Daily Capacity' datatype='integer' name='[Calculation_0947567766745090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date], [room_type_id] : MIN([available_rooms]) }' />
            </column>
            <column caption='LOD Daily Occupancy' datatype='real' name='[Calculation_0947567766831107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date] : SUM([Calculation_0947567766609921]) } / { FIXED [date] : SUM([Calculation_0947567766745090]) }' />
            </column>
            <column caption='Demand Category (Fixed)' datatype='string' name='[Calculation_0947567767019524]' role='dimension' type='nominal'>
