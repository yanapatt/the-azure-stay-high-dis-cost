                    <story-point caption='Hypothesis 1 (เพิ่มเติม)' captured-sheet='Hypothesis1.4' id='14' />
                    <story-point caption='Hypothesis 2: ค่าใช้จ่ายด้านการตลาด (Marketing Spend) บน Google Ads มี ROI (Return on Investment) และช่วยลด COA % ได้ดีกว่าการยอมจ่ายค่าคอมมิชชันแบบ Flat Rate หรือ Percentage ให้กับ OTA' captured-sheet='Hypothesis2.1' id='4' />
                    <story-point caption='Hypothesis 3: ช่องทาง OTA มีอัตรา Cancel/No-Show สูงกว่า ทำให้โรงแรมเสียโอกาส (Opportunity Cost) ในการขายห้องที่ว่างให้ช่องทางที่กำไรสูงกว่า' captured-sheet='Hypothesis3.1' id='7' />
                    <story-point caption='Hypothesis 3 (เพิ่มเติม)' captured-sheet='Hypothesis3.2' id='10' />
                    <story-point caption='Hypothesis 3 (เพิ่มเติม)' captured-sheet='Hypothesis3.3' id='11'>
                      <capturedDeltas>
                        <worksheet name='Hypothesis3.3'>
                          <selection-collection />
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Hypothesis 4: ลูกค้าเก่าส่วนใหญ่ยังคงพึ่งพาช่องทาง OTA ในการจองห้องพัก (High OTA Dependency) ซึ่งทำให้โรงแรมสูญเสียกำไรจากค่าคอมมิชชันโดยไม่จำเป็น (Revenue Leakage) หากโรงแรมทำแคมเปญกระตุ้นให้ลูกค้าเก่าจองตรง (Direct) แม้จะต้องให้ส่วนลดเทียบเท่าหรือน้อยกว่าค่าคอมมิชชัน ก็จะสามารถเพิ่ม Net Profit Margin ได้อย่างมีนัยสำคัญ' captured-sheet='Hypothesis4' id='8'>
                      <capturedDeltas>
                        <worksheet name='Hypothesis4'>
                          <annotations>
                            <annotation class='point' delta-type='edited' id='0' mark-position='1' pullback='12' text-width='197'>
                              <formatted-text>
                                <run fontcolor='#757575'>Booking Share %: </run>
                                <run bold='true'><![CDATA[<[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0162241548107780:qk]>]]></run>
                              </formatted-text>
                              <point>
                                <visual-coordinate class='mark'>
                                  <tuple-reference>
                                    <tuple-descriptor>
                                      <pane-descriptor>
                                        <x-fields>
