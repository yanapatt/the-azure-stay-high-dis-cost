    <worksheet name='Net Opportunity (Shows)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='14'>Net Opportunity Loss by Channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_date+ (AzureStay_Data_2025)' name='federated.1lsanfy1tem9aa1b6f4g41qxk9fb' />
          </datasources>
          <datasource-dependencies datasource='federated.1lsanfy1tem9aa1b6f4g41qxk9fb'>
            <column caption='Length Of Stay' datatype='integer' name='[Calculation_0206221829160961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [check_in_date], [check_out_date])' />
            </column>
            <column caption='Daily Net Room Revenue' datatype='real' name='[Calculation_0206221829292034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[net_room_revenue] / [Calculation_0206221829160961]' />
            </column>
            <column caption='Recovered Revenue' datatype='real' name='[Calculation_0206221898047519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [Calculation_0206221829292034] ELSE 0 END' />
            </column>
            <column caption='Loss Rooms Night' datatype='integer' name='[Calculation_0206221908439081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [number_of_rooms] ELSE 0 END' />
            </column>
            <column caption='Potential Revenue' datatype='real' name='[Calculation_0206221908709418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221908439081]) * [Calculation_0206221910970412]' />
            </column>
            <column caption='Net Opportunity Loss' datatype='real' name='[Calculation_0206221908955179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221898047519]) - [Calculation_0206221908709418]' />
            </column>
            <column caption='NetADR (Checked)' datatype='real' name='[Calculation_0206221910970412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221913915437]) / SUM([Calculation_0206221914021934])' />
            </column>
            <column caption='Filtered Net Revenue' datatype='real' name='[Calculation_0206221913915437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Confirmed&apos; OR [status] = &apos;Checked-Out&apos; &#13;&#10;THEN [Calculation_0206221829292034] &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Filtered Room Count' datatype='integer' name='[Calculation_0206221914021934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Confirmed&apos; OR [status] = &apos;Checked-Out&apos; &#13;&#10;THEN [number_of_rooms] &#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Channel Name' datatype='string' name='[channel_name]' role='dimension' type='nominal' />
            <column caption='Check In Date' datatype='date' name='[check_in_date]' role='dimension' type='ordinal' />
            <column caption='Check Out Date' datatype='date' name='[check_out_date]' role='dimension' type='ordinal' />
            <column caption='Net Room Revenue' datatype='real' name='[net_room_revenue]' role='measure' type='quantitative' />
            <column-instance column='[channel_name]' derivation='None' name='[none:channel_name:nk]' pivot='key' type='nominal' />
            <column caption='Number Of Rooms' datatype='integer' name='[number_of_rooms]' role='measure' type='quantitative' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0206221908955179]' derivation='User' name='[usr:Calculation_0206221908955179:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[none:channel_name:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0206221908955179:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0206221908955179:qk]' scope='cols' value='Net Opportunity Loss' />
