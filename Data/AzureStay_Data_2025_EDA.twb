      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0206221829443587:qk]&quot;' value='Net ADR' />
          <alias key='&quot;[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0206221831340038:qk]&quot;' value='Net RevPAR' />
        </aliases>
      </column>
      <column caption='Booking Share %' datatype='real' name='[Calculation_0162241548107780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0206221859119124] / SUM({ EXCLUDE [channel_type] : [Calculation_0206221859119124] })' />
      </column>
      <column caption='Length Of Stay' datatype='integer' name='[Calculation_0206221829160961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [check_in_date], [check_out_date])' />
      </column>
      <column caption='Daily Net Room Revenue' datatype='real' name='[Calculation_0206221829292034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[net_room_revenue] / [Calculation_0206221829160961]' />
      </column>
      <column caption='NetADR' datatype='real' name='[Calculation_0206221829443587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0206221829292034]) / SUM([number_of_rooms])' />
      </column>
      <column caption='Filter Status' datatype='boolean' name='[Calculation_0206221829849092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[status] = &apos;Checked-Out&apos; OR [status] = &apos;Confirmed&apos;' />
      </column>
      <column caption='Total Rooms Available' datatype='integer' name='[Calculation_0206221830967301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [room_type_name]: MIN([available_rooms]) }' />
      </column>
      <column caption='NetRevPAR' datatype='real' name='[Calculation_0206221831340038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0206221829292034]) / SUM([Calculation_0206221830967301])' />
      </column>
      <column caption='Total True Revenue' datatype='real' name='[Calculation_0206221838430215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// ใช้ ZN เพื่อให้ถ้าไม่มีรายได้เสริม ให้เป็น 0 แทนที่จะเป็น Null&#13;&#10;SUM([Calculation_0206221841735690]) + ZN(SUM([Calculation_0206221843066893]))' />
      </column>
      <column caption='Total Acquisition Cost' datatype='real' name='[Calculation_0206221838659592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_0206221842522123])) + ZN(SUM([cost_amount]))' />
      </column>
      <column caption='TrueCOA%' datatype='real' default-format='p0.00%' name='[Calculation_0206221838856201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0206221838659592] / [Calculation_0206221838430215]' />
      </column>
      <column caption='Daily Gross Room Revenue' datatype='real' name='[Calculation_0206221841735690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gross_room_revenue] / [Calculation_0206221829160961]' />
      </column>
      <column caption='Daily Commission' datatype='real' name='[Calculation_0206221842522123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_amount] / [Calculation_0206221829160961]' />
      </column>
      <column caption='Daily Ancillary' datatype='real' name='[Calculation_0206221843066893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ancillary_revenue] / [Calculation_0206221829160961]' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_0206221859119124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([booking_id])' />
      </column>
      <column caption='ROI Multiplier' datatype='real' default-format='p0.00%' name='[Calculation_0206221878022167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// ควรใช้ Total True Revenue ไหม&#13;&#10;(SUM([Calculation_0206221829292034]) - [Calculation_0206221838659592]) / [Calculation_0206221838659592]' />
      </column>
      <column caption='Day Of Week' datatype='string' name='[Calculation_0206221885763609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
      </column>
      <column caption='Is Weekend' datatype='string' name='[Calculation_0206221886345242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [date]) = 1 OR DATEPART(&apos;weekday&apos;, [date]) = 7 THEN &apos;Weekend&apos; ELSE &apos;Weekday&apos; END' />
      </column>
      <column caption='Market Share (H3)' datatype='real' default-format='p0.0000%' name='[Calculation_0206221895847965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_of_rooms]) / TOTAL(SUM([number_of_rooms]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Recovered Revenue' datatype='real' name='[Calculation_0206221898047519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [Calculation_0206221829292034] ELSE 0 END' />
      </column>
      <column caption='Overall Hotel Net ADR' datatype='real' name='[Calculation_0206221906186278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : &#13;&#10;    SUM(IF [status] IN (&apos;Checked-Out&apos;, &apos;Confirmed&apos;) THEN [Calculation_0206221829292034] END)&#13;&#10;    /&#13;&#10;    SUM(IF [status] IN (&apos;Checked-Out&apos;, &apos;Confirmed&apos;) THEN 1 END)&#13;&#10;}' />
      </column>
      <column caption='Channel Net ADR' datatype='real' name='[Calculation_0206221906513959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [status] IN (&apos;Checked-Out&apos;, &apos;Confirmed&apos;) THEN [Calculation_0206221829292034] END)&#13;&#10;/&#13;&#10;SUM(IF [status] IN (&apos;Checked-Out&apos;, &apos;Confirmed&apos;) THEN 1 END)' />
      </column>
      <column caption='Loss Rooms Night' datatype='integer' name='[Calculation_0206221908439081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [number_of_rooms] ELSE 0 END' />
      </column>
      <column caption='Potential Revenue' datatype='real' name='[Calculation_0206221908709418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0206221908439081]) * [Calculation_0206221910970412]' />
      </column>
      <column caption='Net Opportunity Loss' datatype='real' name='[Calculation_0206221908955179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0206221898047519]) - [Calculation_0206221908709418]' />
      </column>
      <column caption='NetADR (Checked)' datatype='real' name='[Calculation_0206221910970412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0206221913915437]) / SUM([Calculation_0206221914021934])' />
      </column>
      <column caption='Filtered Net Revenue' datatype='real' name='[Calculation_0206221913915437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;Confirmed&apos; OR [status] = &apos;Checked-Out&apos; &#13;&#10;THEN [Calculation_0206221829292034] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Filtered Room Count' datatype='integer' name='[Calculation_0206221914021934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &apos;Confirmed&apos; OR [status] = &apos;Checked-Out&apos; &#13;&#10;THEN [number_of_rooms] &#13;&#10;ELSE 0 &#13;&#10;END' />
      </column>
      <column caption='Occupancy' datatype='real' default-format='p0.00%' name='[Calculation_0674339105497088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([number_of_rooms]) / SUM([Calculation_0206221830967301])' />
      </column>
      <column caption='LOD Daily Sold' datatype='integer' name='[Calculation_0947567766609921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [booking_id] : SUM([number_of_rooms]) }' />
      </column>
      <column caption='LOD Daily Capacity' datatype='integer' name='[Calculation_0947567766745090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [room_type_id] : MIN([available_rooms]) }' />
      </column>
      <column caption='LOD Daily Occupancy' datatype='real' name='[Calculation_0947567766831107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date] : SUM([Calculation_0947567766609921]) } / { FIXED [date] : SUM([Calculation_0947567766745090]) }' />
      </column>
      <column caption='Demand Category (Fixed)' datatype='string' name='[Calculation_0947567767019524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0947567766831107] &gt;= 0.90 THEN &quot;High Demand&quot; ELSE &quot;Regular Demand&quot; END' />
      </column>
      <column caption='Market Share' datatype='real' default-format='p0.0000%' name='[Market Share (copy)_0243880346431488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_0947567767019524], [channel_type] : SUM([number_of_rooms]) } / { FIXED [Calculation_0947567767019524] : SUM([number_of_rooms])}' />
      </column>
      <column caption='COA%' datatype='real' default-format='p0.00%' name='[TrueCOA% (copy)_0206221883121688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0206221838659592] / SUM([Calculation_0206221841735690])' />
      </column>
