    <worksheet name='Hypothesis2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Cost of Acquisition (COA%) Analysis by Booking Channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_date+ (AzureStay_Data_2025)' name='federated.1lsanfy1tem9aa1b6f4g41qxk9fb' />
          </datasources>
          <datasource-dependencies datasource='federated.1lsanfy1tem9aa1b6f4g41qxk9fb'>
            <column caption='Length Of Stay' datatype='integer' name='[Calculation_0206221829160961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [check_in_date], [check_out_date])' />
            </column>
            <column caption='Daily Net Room Revenue' datatype='real' name='[Calculation_0206221829292034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[net_room_revenue] / [Calculation_0206221829160961]' />
            </column>
            <column caption='Filter Status' datatype='boolean' name='[Calculation_0206221829849092]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[status] = &apos;Checked-Out&apos; OR [status] = &apos;Confirmed&apos;' />
            </column>
            <column caption='Total Acquisition Cost' datatype='real' name='[Calculation_0206221838659592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_0206221842522123])) + ZN(SUM([cost_amount]))' />
            </column>
            <column caption='Daily Gross Room Revenue' datatype='real' name='[Calculation_0206221841735690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gross_room_revenue] / [Calculation_0206221829160961]' />
            </column>
            <column caption='Daily Commission' datatype='real' name='[Calculation_0206221842522123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[commission_amount] / [Calculation_0206221829160961]' />
            </column>
            <column caption='ROI Multiplier' datatype='real' default-format='p0.00%' name='[Calculation_0206221878022167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// ควรใช้ Total True Revenue ไหม&#13;&#10;(SUM([Calculation_0206221829292034]) - [Calculation_0206221838659592]) / [Calculation_0206221838659592]' />
            </column>
            <column caption='COA%' datatype='real' default-format='p0.00%' name='[TrueCOA% (copy)_0206221883121688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0206221838659592] / SUM([Calculation_0206221841735690])' />
            </column>
            <column-instance column='[commission_model]' derivation='Attribute' name='[attr:commission_model:nk]' pivot='key' type='nominal' />
            <column caption='Channel Name' datatype='string' name='[channel_name]' role='dimension' type='nominal' />
            <column caption='Channel Type' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Check In Date' datatype='date' name='[check_in_date]' role='dimension' type='ordinal' />
            <column caption='Check Out Date' datatype='date' name='[check_out_date]' role='dimension' type='ordinal' />
            <column caption='Commission Amount' datatype='real' name='[commission_amount]' role='measure' type='quantitative' />
            <column caption='Commission Model' datatype='string' name='[commission_model]' role='dimension' type='nominal' />
            <column caption='Cost Amount' datatype='real' name='[cost_amount]' role='measure' type='quantitative' />
            <column caption='Gross Room Revenue' datatype='integer' name='[gross_room_revenue]' role='measure' type='quantitative' />
            <column caption='Net Room Revenue' datatype='real' name='[net_room_revenue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0206221829849092]' derivation='None' name='[none:Calculation_0206221829849092:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel_name]' derivation='None' name='[none:channel_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel_type]' derivation='None' name='[none:channel_type:nk]' pivot='key' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0206221878022167]' derivation='User' name='[usr:Calculation_0206221878022167:qk]' pivot='key' type='quantitative' />
            <column-instance column='[TrueCOA% (copy)_0206221883121688]' derivation='User' name='[usr:TrueCOA% (copy)_0206221883121688:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
