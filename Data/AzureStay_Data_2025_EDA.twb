            <shelf-sort-v2 dimension-to-sort='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[none:rate_name:nk]' direction='ASC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1lsanfy1tem9aa1b6f4g41qxk9fb].[usr:Calculation_0206221829443587:qk]' shelf='columns' />
