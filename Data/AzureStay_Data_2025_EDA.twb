            <column caption='Recovered Revenue' datatype='real' name='[Calculation_0206221898047519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [Calculation_0206221829292034] ELSE 0 END' />
            </column>
            <column caption='Loss Rooms Night' datatype='integer' name='[Calculation_0206221908439081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &apos;Cancelled&apos; OR [status] = &apos;No-Show&apos; THEN [number_of_rooms] ELSE 0 END' />
            </column>
            <column caption='Potential Revenue' datatype='real' name='[Calculation_0206221908709418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221908439081]) * [Calculation_0206221910970412]' />
            </column>
            <column caption='Net Opportunity Loss' datatype='real' name='[Calculation_0206221908955179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0206221898047519]) - [Calculation_0206221908709418]' />
